{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ForgePay zero-downtime migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "phase", "releaseDigest", "sourceRevision", "compatibleApplications", "preconditions", "lockSafety", "backfill", "integrityValidation", "rollback", "approvals"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"},
    "phase": {"enum": ["expand", "backfill", "switch", "contract"]},
    "releaseDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "sourceRevision": {"type": "string", "pattern": "^[a-f0-9]{7,64}$"},
    "compatibleApplications": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "preconditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "lockSafety": {
      "type": "object", "additionalProperties": false,
      "required": ["expectedLock", "lockTimeout", "statementTimeout", "testedInRepresentativeEnvironment"],
      "properties": {
        "expectedLock": {"type": "string", "minLength": 1},
        "lockTimeout": {"type": "string", "pattern": "^[1-9][0-9]*(ms|s|m)$"},
        "statementTimeout": {"type": "string", "pattern": "^[1-9][0-9]*(ms|s|m|h)$"},
        "testedInRepresentativeEnvironment": {"type": "boolean"}
      }
    },
    "backfill": {"type": "object", "additionalProperties": false, "required": ["required", "strategy"], "properties": {"required": {"type": "boolean"}, "strategy": {"type": "string", "minLength": 1}}},
    "integrityValidation": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "rollback": {"type": "object", "additionalProperties": false, "required": ["applicationRollback", "databaseRecoveryDecision"], "properties": {"applicationRollback": {"type": "string", "minLength": 1}, "databaseRecoveryDecision": {"type": "string", "minLength": 1}}},
    "approvals": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {"if": {"properties": {"phase": {"const": "backfill"}}}, "then": {"properties": {"backfill": {"properties": {"required": {"const": true}}}}}},
    {"if": {"properties": {"phase": {"const": "contract"}}}, "then": {"properties": {"compatibleApplications": {"maxItems": 1}}}}
  ]
}
